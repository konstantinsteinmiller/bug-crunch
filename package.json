{
  "name": "bug-crunch",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-playgama": "vite --mode playgama",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:crazy-web": "vite build --mode crazy-web --base=./ ",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && wavedash build push",
    "build:itch": "vite build --mode itch --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-itch.zip",
    "build:glitch": "vite build --mode glitch --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-glitch.zip",
    "build:game-distribution": "vite build --mode game-distribution --base=./",
    "build:playgama": "vite build --mode playgama --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-playgama.zip",
    "build:gamepix": "vite build --mode gamepix --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-gamepix.zip",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-gamemonetize.zip",
    "build:yandex": "vite build --mode yandex --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-yandex.zip",
    "build:poki": "vite build --mode poki --base=./ && node tools/zip-dist.mjs dist dist/bug-crunch-poki.zip",
    "deploy:poki": "node tools/poki-deploy/deploy.mjs",
    "build-github-main": "vite build --base=/bug-crunch/ --outDir=dist",
    "build-github-develop": "vite build --base=/bug-crunch/develop/ --outDir=dist/develop",
    "deploy": "vite build && surge dist/ --domain bug-crunch.surge.sh",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "leaderboard:seed": "node scripts/leaderboard-seed.mjs",
    "leaderboard:snapshot": "node scripts/leaderboard-snapshot.mjs",
    "perf:ab": "node scripts/perf-ab.mjs",
    "perf:play": "node scripts/perf-play.mjs",
    "qa:portal": "node scripts/portal-qa.mjs",
    "compress-folder": "node scripts/compress-images.mjs",
    "compress-bench": "node scripts/image-compress-bench.mjs",
    "compress-folder-with-backup": "node scripts/compress-images.mjs public/images --max-effort --backup-dir public-backup",
    "compress-promotion-with-backup": "node scripts/compress-images.mjs src/assets/promotion --max-effort --backup-dir src/assets/promotion-backup",
    "art:bg-tile": "node tools/bg-tile.mjs",
    "art:export": "node tools/export-sheets.mjs",
    "slice-sheets": "node tools/slice-sheets.mjs",
    "art:prompts": "node --import ./tools/ts-resolve.mjs tools/art-prompts.mjs",
    "art:models": "node tools/art-models.mjs",
    "art:status": "node --import ./tools/ts-resolve.mjs tools/art-status.mjs",
    "art:measure": "python tools/measure-art.py",
    "art:desk": "node tools/art-desk/server.mjs",
    "art:promotion": "node --import ./tools/ts-resolve.mjs tools/art-promotion.mjs",
    "preview:video": "node tools/preview-video/record.mjs",
    "audio:render": "node --import ./tools/ts-resolve.mjs tools/audio/render-sfx.mjs",
    "music:render": "node tools/music/render.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "@wvdsh/sdk-js": "^0.0.38",
    "lodash.clonedeep": "^4.5.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@napi-rs/image": "^1.14.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sharp": "^0.35.4",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
